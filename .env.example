# Copy to .env for local development. .env is gitignored -- keep it that way.
# In normal use these go in your MCP client's `env` block, not a file.

# From https://developer.whoop.com/ -> your application
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match a registered redirect URL exactly.
# WHOOP rejects http://, including http://localhost -- use https:// or a
# custom scheme. See docs/SETUP.md.
WHOOP_REDIRECT_URI=whoopmcp://callback

# Optional. Narrowing scopes is the strongest privacy control available:
# a scope you never grant is data this server can never read.
# `offline` is required for refresh tokens.
#WHOOPMCP_SCOPES=read:recovery read:sleep read:cycles read:workout offline

# Optional. `keyring` needs: pip install 'whoopmcp[keyring]'
#WHOOPMCP_TOKEN_BACKEND=file
#WHOOPMCP_STATE_DIR=~/.local/state/whoopmcp
#WHOOPMCP_CACHE=false
#WHOOPMCP_TIMEOUT=30
