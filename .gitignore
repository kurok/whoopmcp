# Credentials and local state -- never commit these
.env
.env.*
!.env.example
token.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors and OS
.idea/
.vscode/
.DS_Store

# No lockfile by design: CI installs with `uv pip install -e .` against the
# declared ranges so a dependency release that breaks the server is caught.
uv.lock
